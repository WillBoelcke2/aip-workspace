rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function email() { return request.auth.token.email; }

    // Só contas Google verificadas do domínio da empresa.
    function membro() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && email().matches('.*@aipathology[.]com[.]br$');
    }
    function papel() {
      return exists(/databases/$(database)/documents/members/$(email()))
        ? get(/databases/$(database)/documents/members/$(email())).data.get('role', 'editor')
        : 'editor';
    }
    function dono() {
      return exists(/databases/$(database)/documents/settings/owner)
        && get(/databases/$(database)/documents/settings/owner).data.email == email();
    }
    function admin() { return membro() && (dono() || papel() == 'admin'); }
    function edita() { return membro() && (dono() || papel() != 'leitor'); }

    // Páginas e itens. lock == false: todo o time. lock == true: só quem está em acl, além dos administradores.
    match /pages/{id} {
      allow read: if admin() || (membro() && (resource.data.lock == false || email() in resource.data.acl));
      allow create: if admin() || (edita() && (request.resource.data.lock == false || email() in request.resource.data.acl));
      allow update: if admin() || (edita()
        && (resource.data.lock == false || email() in resource.data.acl)
        && request.resource.data.lock == resource.data.lock
        && request.resource.data.get('acl', []) == resource.data.get('acl', []));
      allow delete: if admin() || (edita() && (resource.data.lock == false || email() in resource.data.acl));
    }

    // Histórico de versões: mesma visibilidade da página a que pertence.
    match /pages/{id}/versions/{v} {
      allow read: if admin() || (membro()
        && (get(/databases/$(database)/documents/pages/$(id)).data.lock == false
          || email() in get(/databases/$(database)/documents/pages/$(id)).data.acl));
      allow create, delete: if admin() || (edita()
        && (get(/databases/$(database)/documents/pages/$(id)).data.lock == false
          || email() in get(/databases/$(database)/documents/pages/$(id)).data.acl));
    }

    // Quem já entrou e o papel de cada um. Só administradores mudam papéis.
    match /members/{m} {
      allow read: if membro();
      allow create: if admin() || (membro() && m == email() && !('role' in request.resource.data));
      allow update: if admin() || (membro() && m == email()
        && request.resource.data.get('role', null) == resource.data.get('role', null));
      allow delete: if admin();
    }

    // Dono do workspace: a primeira conta do domínio que entrar depois de publicar estas regras.
    match /settings/owner {
      allow read: if membro();
      allow create: if membro() && request.resource.data.email == email();
      allow update, delete: if dono();
    }
  }
}
